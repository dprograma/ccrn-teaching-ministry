# Neon connection strings (set these in Vercel project settings, and locally in .env for migrations)
# Pooled connection, used by the app at runtime via the driver adapter.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Direct (non-pooled) connection, used only by Prisma Migrate/CLI.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with: npx auth secret"

# Vercel Blob (file storage for covers, ministry's own audio, news photos)
BLOB_READ_WRITE_TOKEN="PLACEHOLDER"

# Paystack (NGN giving)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="PLACEHOLDER"
PAYSTACK_SECRET_KEY="PLACEHOLDER"

# Flutterwave (USD giving)
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY="PLACEHOLDER"
FLUTTERWAVE_SECRET_KEY="PLACEHOLDER"
