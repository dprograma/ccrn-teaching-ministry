# Neon connection strings (set these in Vercel project settings, and locally in .env for migrations)
# Pooled connection, used by the app at runtime via the driver adapter.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Direct (non-pooled) connection, used only by Prisma Migrate/CLI.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with: npx auth secret"

# Vercel Blob (file storage for covers, ministry's own audio, news photos)
BLOB_READ_WRITE_TOKEN="PLACEHOLDER"

# Partner with us — bank transfer (shown as plain text + a copy button).
# NEVER real values until the parish has confirmed the account.
NEXT_PUBLIC_BANK_ACCOUNT_NAME="PLACEHOLDER — ministry/parish account name"
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER="PLACEHOLDER — account number"
NEXT_PUBLIC_BANK_NAME="PLACEHOLDER — bank name"

# Partner with us — Paystack (NGN giving). The hosted-checkout flow this site
# uses only calls Paystack's server-to-server API with the secret key; the
# public key isn't required unless this is later switched to an inline/popup
# widget instead of the redirect flow.
PAYSTACK_SECRET_KEY="PLACEHOLDER"

# Partner with us — Flutterwave (USD giving, for members abroad). Same
# hosted-checkout pattern: only the secret key is used server-side.
FLUTTERWAVE_SECRET_KEY="PLACEHOLDER"
