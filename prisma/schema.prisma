generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Admin / auth ───────────────────────────────────────────────

enum AdminRole {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ebooks    EBook[]
  teachings Teaching[]
  selah     SelahEntry[]
  photos    NewsPhoto[]
  talks     TalkAssignment[]
}

// ── eBooks ──────────────────────────────────────────────────────

enum EBookStatus {
  DRAFT
  PUBLISHED
}

model EBook {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  subtitle    String?
  description String
  seriesLabel String? // small kicker shown on the cover, e.g. "Teach the Teacher"
  coverUrl    String? // generated or uploaded cover image
  status      EBookStatus @default(DRAFT)
  position    Int         @default(0) // manual ordering in the shelf

  chapters EBookChapter[]

  createdById String?
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, position])
}

model EBookChapter {
  id       String @id @default(cuid())
  ebookId  String
  ebook    EBook  @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  position Int
  title    String
  // Stored as simple structured HTML/markdown-lite content, rendered
  // identically for the web reader and the generated PDF.
  content  String @db.Text

  @@index([ebookId, position])
}

// ── Teachings archive ──────────────────────────────────────────

enum TeachingStatus {
  DRAFT
  PUBLISHED
}

model Teaching {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  speaker     String?
  scripture   String?
  summary     String
  body        String?        @db.Text // write-up, if any
  videoUrl    String? // link to an official video, if any
  status      TeachingStatus @default(DRAFT)
  publishedAt DateTime?

  createdById String?
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
}

// ── Selah ─────────────────────────────────────────────────────

enum SelahSection {
  STUDY // for study and quiet time
  WORSHIP // for worship and praise
}

enum SelahLanguage {
  LATIN
  YORUBA
  IGBO
  HAUSA
  ENGLISH
}

enum SelahSourceType {
  EMBED // official YouTube/Spotify link — audio never leaves their servers
  HOSTED // the ministry's own recording, stored in our own blob storage
}

model SelahEntry {
  id          String          @id @default(cuid())
  title       String
  language    SelahLanguage
  section     SelahSection
  description String // one line on what it is / which truth it carries
  sourceType  SelahSourceType
  embedUrl    String? // required when sourceType = EMBED
  audioUrl    String? // required when sourceType = HOSTED (our own storage)
  position    Int             @default(0)
  published   Boolean         @default(false)

  createdById String?
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([section, language, published])
}

// ── News photos ───────────────────────────────────────────────

model NewsPhoto {
  id       String  @id @default(cuid())
  url      String
  caption  String?
  position Int     @default(0)

  createdById String?
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
}

// ── Teach the Teacher: roster + Upcoming Talks ──────────────────
//
// The public "Teach the Teacher" page itself is still the static
// nine-module curriculum (lib/content/curriculum.ts) — this roster is
// a separate, admin-managed list of named teachers, used only as the
// assignment target for TalkAssignment below.

model Teacher {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  talks     TalkAssignment[]
  createdAt DateTime         @default(now())
}

model TalkAssignment {
  id          String   @id @default(cuid())
  topic       String
  description String
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  scheduledAt DateTime // date and time of delivery

  createdById String?
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([scheduledAt])
}
